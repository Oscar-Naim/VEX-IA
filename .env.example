# LYAXIS labs™ - Configuración de Variables de Entorno
# Ingresa tu clave de Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Ingresa tu clave de Groq Cloud API (https://console.groq.com/keys)
GROQ_API_KEY=

# Proveedor activo por defecto ('gemini' o 'groq')
VEX_ACTIVE_PROVIDER=gemini

# Ingresa tu clave de ElevenLabs API (https://elevenlabs.io)
ELEVENLABS_API_KEY=

# Motor de voz preferido ('edge-tts' o 'elevenlabs')
VEX_TTS_ENGINE=edge-tts
